__pycache__/
.ipynb_checkpoints/
.vscode/
.pytest_cache/
data/external/

# --- Offline Android app (Flutter) -----------------------------------------
# Build output and the Dart/Flutter tool caches; regenerated by every build.
android_app/build/
android_app/.dart_tool/
android_app/.flutter-plugins
android_app/.flutter-plugins-dependencies
android_app/android/.gradle/

# Built APK artifacts (sideloading output, not source).
*.apk

# Android signing secrets & local keystores (never commit).
android_app/android/key.properties
android_app/android/*.jks
android_app/android/*.keystore
android_app/android/lineage.bin
